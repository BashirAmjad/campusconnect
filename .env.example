# Hosted PostgreSQL (Neon) connection string - use the pooled URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Long random string used to sign session tokens
JWT_SECRET=replace-with-a-long-random-string
# Password given to seeded demo accounts (only used by npm run db:seed)
SEED_PASSWORD=choose-a-demo-password
